# Supabase (added automatically by the Vercel Marketplace integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: drop matches below this cosine similarity (0 to 1). Default 0 = keep the top 3.
# KB_MIN_SIMILARITY=0.8
# Optional: set to off to silence the server's JSON logs.
# RESOLVE_LOG=off

# Slack updates (optional). Posted through Slack's hosted MCP server (https://mcp.slack.com/mcp) after a human decides a refund.
# Needs a Slack app that is internal or Marketplace-published, with the MCP integration approved by a workspace admin, and the
# redirect URL https://<your-host>/api/slack/callback added to the app. Then run supabase/migrations/002_slack_oauth.sql and,
# once, sign in to Resolve and open /api/slack/connect to authorise. Posts appear as the user who connected.
# SLACK_CLIENT_ID=1234567890.1234567890
# SLACK_CHANNEL_ID=C0123456789
# Optional: only if your Slack app has a client secret, a different scope, or Resolve sits behind a proxy.
# SLACK_CLIENT_SECRET=
# SLACK_OAUTH_SCOPE=chat:write
# SLACK_REDIRECT_URL=https://your-host/api/slack/callback
# Optional: pin the message tool by name if the server lists several that look alike. Default: found from the tool list.
# SLACK_MCP_TOOL=
# SLACK_MCP_URL=https://mcp.slack.com/mcp

# Shared sign-in token (same for every user). Required; without it nobody can sign in.
RESOLVE_ACCESS_TOKEN=change-me
