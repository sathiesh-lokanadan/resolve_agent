# Supabase (added automatically by the Vercel Marketplace integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: drop matches below this cosine similarity (0 to 1). Default 0 = keep the top 3.
# KB_MIN_SIMILARITY=0.8
# Optional: set to off to silence the server's JSON logs.
# RESOLVE_LOG=off

# Slack updates (optional). Posted through a Slack MCP server after a human approves or rejects a refund.
# Needs a Slack bot token (scopes chat:write, channels:read), your workspace id (T...), and a channel id (C...) the bot was invited to.
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_TEAM_ID=T0123456789
# SLACK_CHANNEL_ID=C0123456789
# Optional: another stdio MCP server that has a slack_post_message tool (channel_id, text). Default: npx -y @modelcontextprotocol/server-slack
# SLACK_MCP_COMMAND=npx
# SLACK_MCP_ARGS=-y @modelcontextprotocol/server-slack

# Shared sign-in token (same for every user). Required; without it nobody can sign in.
RESOLVE_ACCESS_TOKEN=change-me
